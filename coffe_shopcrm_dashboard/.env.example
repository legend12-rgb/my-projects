# Copy this file to .env and fill in the real values from your Supabase project.
# .env is gitignored — never commit real secrets.

# Project API (Settings -> API)
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key            # safe in the browser (read-only via RLS)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # backend only — full write access

# Direct Postgres connection for the bulk importer (Settings -> Database).
# Use the connection string; URL-encode special characters in the password.
DATABASE_URL=postgresql://postgres:YOUR-DB-PASSWORD@db.YOUR-PROJECT-ref.supabase.co:5432/postgres
